# Copy to .env.local (gitignored) and fill in. Never commit .env.local.

# Backend the dev server proxies to. Defaults to staging when unset.
# API_URL=http://localhost:4000
API_URL=https://talentcona-backend.onrender.com

# Idle timeout is 15 minutes. Set this (e.g. 1) only to test the timeout locally,
# then remove it and restart the dev server. Not a secret.
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=1

# Your OWN admin test account (ask the team lead). Only used by local scripts —
# the app itself never reads these; you type them into the sign-in page.
TC_ADMIN_EMAIL=
TC_ADMIN_PASSWORD=
