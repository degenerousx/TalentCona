# Copy to .env.local (gitignored) and fill in. Never commit .env.local.

# Backend the dev server proxies to. Defaults to staging when unset.
# API_URL=http://localhost:4000
API_URL=https://talentcona-backend.onrender.com

# Idle timeout is 15 minutes. Set this (e.g. 1) only to test the timeout locally,
# then remove it and restart the dev server. Not a secret.
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=1

# Your OWN admin test account (ask the team lead). Only used by local scripts —
# the app itself never reads these; you type them into the sign-in page.
TC_ADMIN_EMAIL=
TC_ADMIN_PASSWORD=

# Talent Match reads both public forms' submissions from Formcarry.
# Secret: server-side only, never NEXT_PUBLIC_. Create it in Formcarry → API Keys.
FORMCARRY_API_KEY=
# Optional: the TalentMatch form is the default.
# FORMCARRY_FORM_ID=u9y1xR5CtLr
# Optional: a separate form for hiring requests (paid plan). Unset, both forms
# share FORMCARRY_FORM_ID and are told apart by their formType field.
# FORMCARRY_HIRING_FORM_ID=
# Optional: override the submissions endpoint ("{formId}" is filled in).
# FORMCARRY_API_URL=https://formcarry.com/api/form/{formId}/submissions
